<UserControl
    x:Class="Datameter.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Datameter.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Progress sits outside the scroll area. Reading every network takes minutes on a
            first run, and inside the page this scrolled off the bottom where nobody saw it.
        -->
        <StackPanel Grid.Row="0" Padding="30,4,30,10"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <!-- ProgressBar does not stretch on its own; without this it keeps its default width. -->
            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                         HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing IsActive="True" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!--
            Two views, one at a time. Settings outgrew a flyout, and a second window would be a
            second thing to manage; swapping the page keeps the app a single window with no
            navigation stack to get lost in.
        -->
        <Grid Grid.Row="1">
        <ScrollViewer x:Name="MainView" Padding="30,10,30,30" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">

                <!-- Heading, period picker, settings -->
                <Grid Margin="0,10,0,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Data usage" VerticalAlignment="Center"
                               FontSize="28" FontWeight="SemiBold" />

                    <ComboBox Grid.Column="1" x:Name="PeriodPicker" MinWidth="168"
                              VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.Periods}"
                              SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}"
                              ToolTipService.ToolTip="Time period" />

                    <Button Grid.Column="2" Width="36" Height="34" Padding="0" CornerRadius="6"
                            Click="OnOpenSettings" ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </Grid>

                <!-- Custom range, revealed only when that period is chosen -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14"
                            Visibility="{x:Bind ViewModel.IsCustomRange, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <CalendarDatePicker x:Name="CustomFromPicker" Header="From" MinWidth="180"
                                        DateChanged="OnCustomRangeChanged" />
                    <CalendarDatePicker x:Name="CustomToPicker" Header="To" MinWidth="180"
                                        DateChanged="OnCustomRangeChanged" />
                </StackPanel>

                <!-- Headline total -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,4" MinHeight="62">
                    <TextBlock Text="{x:Bind ViewModel.TotalValue, Mode=OneWay}"
                               FontSize="54" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.TotalUnit, Mode=OneWay}"
                               FontSize="23" VerticalAlignment="Bottom" Margin="-6,0,0,9"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="18"
                                VerticalAlignment="Bottom" Margin="16,0,0,11">
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="13">
                            <Run Text="Sent" />
                            <Run Text="{x:Bind ViewModel.SentText, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="13">
                            <Run Text="Received" />
                            <Run Text="{x:Bind ViewModel.ReceivedText, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>

                        <!--
                            Live speed. A different measurement from everything else on the
                            page: the rest is history Windows recorded by the hour, this is the
                            adapter counters differentiated over the last second. The figures
                            carry a minimum width so the row does not reshuffle every second as
                            the numbers change length.
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Now" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="SpeedUpArrow" Text="&#x2191;" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SpeedUp, Mode=OneWay}" FontSize="13"
                                       FontWeight="SemiBold" MinWidth="62" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SpeedDownArrow" Text="&#x2193;" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SpeedDown, Mode=OneWay}" FontSize="13"
                                       FontWeight="SemiBold" MinWidth="62" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,0,0,18">
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <HyperlinkButton Content="Show all networks" HorizontalAlignment="Right"
                                     Padding="4,0" FontSize="12" Click="OnClearNetworkFilter"
                                     Visibility="{x:Bind ViewModel.IsFiltered, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!--
                    Networks: a proportional bar over a row of tiles, the Storage overview pattern.
                    Both are built in code so the columns can be star-sized from real shares, and
                    so a tile can carry the selected state. Clicking a tile drills into it.
                -->
                <Grid x:Name="ContributionBar" Height="14" Margin="0,0,0,12" />
                <Grid x:Name="NetworkChips" Margin="0,0,0,30" />

                <!-- Empty state -->
                <Border Padding="24" Margin="0,0,0,20" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Nothing recorded for this period" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a longer period, or leave Datameter running to build up history."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Per-app usage, the Settings breakdown -->
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{x:Bind ViewModel.AppsTitle, Mode=OneWay}" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.AppsNote, Mode=OneWay}" FontSize="11.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>

                <!--
                    Placeholder rows while the per-app query is out. It is a live call to
                    Windows, several seconds per network, so the shape of the answer goes up
                    immediately and fills in rather than leaving a blank gap.
                -->
                <StackPanel x:Name="AppSkeleton" Spacing="8" Margin="0,0,0,10"
                            Visibility="{x:Bind ViewModel.IsLoadingApps, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}" Margin="0,0,0,10"
                              Visibility="{x:Bind ViewModel.ShowAppList, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AppVm">
                            <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="9">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Every logo sits on a plate. Several app icons are
                                            white-on-transparent and would vanish against a
                                            light page without one.
                                        -->
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="5"
                                                Background="{x:Bind IconPlate, Mode=OneWay}">
                                            <Grid>
                                                <Image Source="{x:Bind Icon, Mode=OneWay}"
                                                       Width="{x:Bind IconSize, Mode=OneWay}"
                                                       Height="{x:Bind IconSize, Mode=OneWay}"
                                                       Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                <FontIcon Glyph="&#xECAA;" FontSize="13"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                          Visibility="{x:Bind NoIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind AttributionId}" />

                                        <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <ProgressBar Value="{x:Bind BarPercent}" Maximum="100" Height="4"
                                                 Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="ShowAllAppsButton" Content="Show all apps" Margin="0,0,0,28"
                        HorizontalAlignment="Left" Click="OnShowAllApps"
                        Visibility="{x:Bind ViewModel.HasMoreApps, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <!-- Chart -->
                <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" FontSize="14"
                           FontWeight="SemiBold" Margin="0,0,0,12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Padding="16,14,16,11" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <!--
                        Ruler, plot and the date axis under it. The ruler is its own column so
                        that the plot and the dates below stay aligned with each other; ruler
                        and gridlines are both drawn in code against the same height.
                    -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="ChartRuler" Grid.Row="0" Grid.Column="0" Height="225" />

                        <!--
                            The plot clears the ruler by the column spacing on its left, so it
                            takes the same margin on its right and sits evenly inside the card
                            rather than running up against one edge and not the other.
                        -->
                        <Grid Grid.Row="0" Grid.Column="1" Height="225" Margin="0,0,10,0">
                            <Grid x:Name="ChartGridLines" Height="225" />
                            <Grid x:Name="ChartHost" Height="225" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,9,10,0">
                            <TextBlock Text="{x:Bind ViewModel.AxisStart, Mode=OneWay}" FontSize="11"
                                       HorizontalAlignment="Left"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AxisEnd, Mode=OneWay}" FontSize="11"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Settings. The same controls as the old flyout, given room to breathe. -->
        <ScrollViewer x:Name="SettingsView" Padding="30,10,30,30" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">

                <Grid Margin="0,10,0,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="36" Height="34" Padding="0" CornerRadius="6"
                            Click="OnCloseSettings" ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"
                               FontSize="28" FontWeight="SemiBold" />
                </Grid>

                <Border Padding="18,16" Margin="0,0,0,12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme"
                                     Checked="OnThemeChecked" Tag="Light" />
                        <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme"
                                     Checked="OnThemeChecked" Tag="Dark" />
                        <RadioButton x:Name="ThemeSystem" Content="Use system setting"
                                     GroupName="Theme" Checked="OnThemeChecked" Tag="Default" />
                    </StackPanel>
                </Border>

                <Border Padding="18,16" Margin="0,0,0,12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Speed meter" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="A small always-on-top readout of what is moving right now. Drag it anywhere on screen; right-click it to hide, or to put it back in its default corner."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ToggleSwitch x:Name="MeterToggle" OnContent="Showing" OffContent="Hidden"
                                      Toggled="OnMeterToggled" />
                        <ComboBox x:Name="MeterSizePicker" Header="Size" MinWidth="200"
                                  SelectionChanged="OnMeterSizeChanged">
                            <ComboBoxItem Content="Small" Tag="Small" />
                            <ComboBoxItem Content="Medium" Tag="Medium" />
                            <ComboBoxItem Content="Large" Tag="Large" />
                        </ComboBox>
                        <ComboBox x:Name="SpeedUnitPicker" Header="Units" MinWidth="200"
                                  Margin="0,8,0,0" SelectionChanged="OnSpeedUnitChanged">
                            <ComboBoxItem Content="Kilobits per second" Tag="Kilobits" />
                            <ComboBoxItem Content="Kilobytes per second" Tag="Kilobytes" />
                            <ComboBoxItem Content="Kibibytes per second" Tag="Kibibytes" />
                        </ComboBox>
                        <TextBlock Text="Connections are sold in bits, so kbps matches the figure your provider quotes. A kilobyte is 1000 bytes; a kibibyte is 1024, which is how Windows counts."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Padding="18,16" Margin="0,0,0,12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Launch at startup" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Datameter can only count what it is running for. Left on, it starts with Windows and waits quietly in the notification area, so a day's usage is whole rather than starting from whenever you happened to open it."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ToggleSwitch x:Name="StartupToggle" OnContent="On" OffContent="Off"
                                      Toggled="OnLaunchAtStartupToggled" />

                        <TextBlock Text="Closing the window" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Left on, closing the window puts Datameter back in the notification area rather than shutting it down. Its icon there shows the current speed, and gives you the window back or quits it properly."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ToggleSwitch x:Name="BackgroundToggle"
                                      OnContent="Keeps running" OffContent="Quits"
                                      Toggled="OnRunInBackgroundToggled" />
                    </StackPanel>
                </Border>

                <Border Padding="18,16" Margin="0,0,0,12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="ms-appx:///Assets/logo.png" Width="40" Height="40"
                                   VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock x:Name="AboutName" Text="Datameter"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Text="Version" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Built by Alexander Akinbiyi" FontSize="12"
                                           Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Records are kept in your local Datameter database and survive Windows discarding its own history."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <HyperlinkButton Content="View on GitHub" Padding="0,4" FontSize="13"
                                         NavigateUri="https://github.com/CollaborativeSketch/Datameter" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
